# ---------------------------------------------------------------------------
# Triple PLO environment variables
# Copy to .env.local for local dev. The vertical slice runs with NONE of these
# set (in-memory store + email logged to console).
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Supabase (Phase 3 production persistence) ---
# Public (safe to expose to the browser):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET — server only, bypasses RLS. NEVER expose to the browser:
SUPABASE_SERVICE_ROLE_KEY=

# --- Transactional email (Resend) ---
# If unset, the final score sheet is logged to the server console instead.
RESEND_API_KEY=
EMAIL_FROM="Triple PLO <scores@yourdomain.com>"

# --- Security ---
# Secret used to sign/hash session tokens (generate: openssl rand -base64 32)
SESSION_SECRET=
